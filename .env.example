# ==============================================================================
# CẤU HÌNH MÔI TRƯỜNG PIPELINE HỘ GIA ĐÌNH - NHÂN KHẨU (HDG -> C360 -> BI & API)
# ==============================================================================

# 1. Chế độ thực thi DB (ORACLE: chạy với Oracle DB chuẩn; LOCAL_SQLITE: chạy giả lập siêu nhẹ khi thiếu RAM)
DB_ENGINE=ORACLE
LOCAL_DB_PATH=data/hgd_c360_local.db

# 2. Kết nối Oracle DB Nguồn (Schema VSS)
ORACLE_SRC_HOST=localhost
ORACLE_SRC_PORT=1521
ORACLE_SRC_SERVICE=FREEPDB1
ORACLE_SRC_USER=VSS
ORACLE_SRC_PASSWORD=vss_secret_pwd

# 3. Kết nối Oracle DB Đích (Schema MIRROR & C360)
ORACLE_DST_HOST=localhost
ORACLE_DST_PORT=1521
ORACLE_DST_SERVICE=FREEPDB1
ORACLE_DST_USER=C360
ORACLE_DST_PASSWORD=c360_secret_pwd

# 4. Cấu hình Kafka & Debezium Connect
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
DEBEZIUM_CONNECT_URL=http://localhost:8083

# 5. Tham số sinh dữ liệu & Batch/NRT Sync
SEED_PERSONS=50000
DELTA_INSERT_COUNT=5000
DELTA_UPDATE_COUNT=2000
DELTA_DELETE_COUNT=500
JDBC_BATCH_SIZE=10000
JDBC_NUM_PARTITIONS=8
NRT_BATCH_LIMIT=10000
NRT_SAFE_LAG_SECONDS=120

# 6. Cấu hình Dịch vụ REST API Tra cứu C360
API_HOST=0.0.0.0
API_PORT=8000
# Key mẫu cho môi trường dev (Production chỉ lưu SHA-256 hash trong bảng C360_API_CLIENTS)
DEV_DEFAULT_API_KEY=bhxh_c360_secret_key_2026
AUDIT_BATCH_FLUSH_INTERVAL_SEC=3.0
AUDIT_BATCH_MAX_SIZE=200


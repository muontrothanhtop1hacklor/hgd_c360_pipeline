{
  "name": "vss-oracle-cdc-source",
  "config": {
    "connector.class": "io.debezium.connector.oracle.OracleConnector",
    "tasks.max": "1",
    "database.hostname": "oracle-db",
    "database.port": "1521",
    "database.user": "C##DBZUSER",
    "database.password": "dbz123",
    "database.dbname": "FREE",
    "database.pdb.name": "FREEPDB1",
    "topic.prefix": "vss_cdc",
    "table.include.list": "VSS.VSS_HO_GD_NHANKHAU,VSS.VSS_DM_DBHC,VSS.VSS_DM_DANTOC,VSS.VSS_DM_QUOC_TICH",
    "message.key.columns": "VSS.VSS_HO_GD_NHANKHAU:MA_CD,MA_HO_GD;VSS.VSS_DM_DBHC:ID;VSS.VSS_DM_DANTOC:ID;VSS.VSS_DM_QUOC_TICH:ID",
    "snapshot.mode": "schema_only",
    "log.mining.strategy": "online_catalog",
    "log.mining.batch.size.min": "1000",
    "log.mining.batch.size.max": "50000",
    "log.mining.batch.size.default": "10000",
    "log.mining.sleep.time.min.ms": "200",
    "log.mining.sleep.time.default.ms": "500",
    "log.mining.sleep.time.max.ms": "2000",
    "decimal.handling.mode": "precise",
    "time.precision.mode": "connect",
    "tombstones.on.delete": "true",
    "schema.history.internal.kafka.bootstrap.servers": "kafka:9092",
    "schema.history.internal.kafka.topic": "schemahistory.vss_cdc",
    "max.batch.size": "4096",
    "max.queue.size": "16384",
    "heartbeat.interval.ms": "10000"
  }
}

